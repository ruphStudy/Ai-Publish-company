NODE_ENV=development
LOG_LEVEL=debug

API_PORT=3000
WEB_PORT=5173

JWT_SECRET=change-me-with-at-least-32-chars-for-development-only
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-with-at-least-32-chars-for-development
JWT_REFRESH_EXPIRES_IN=7d

MONGODB_URI=mongodb://localhost:27017/ai_publishing
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-publishing-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

CORS_ORIGINS=*

RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

SWAGGER_ENABLED=true

VITE_API_BASE_URL=http://localhost:3000
