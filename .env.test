NODE_ENV=test
LOG_LEVEL=error

API_PORT=3001

JWT_SECRET=test-jwt-secret-with-at-least-32-chars-for-testing
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret-with-at-least-32-chars-for-testing
JWT_REFRESH_EXPIRES_IN=7d

MONGODB_URI=mongodb://localhost:27017/ai_publishing_test
MONGODB_MAX_POOL_SIZE=5
MONGODB_MIN_POOL_SIZE=1

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TTL=3600

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-publishing-test
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

CORS_ORIGINS=*

RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=1000

SWAGGER_ENABLED=false
