NODE_ENV=production
LOG_LEVEL=info

API_PORT=3000
API_BASE_URL=https://api.yourcompany.com

JWT_SECRET=your-very-secure-jwt-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-very-secure-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your-secure-mongo-password
MONGODB_URI=mongodb://admin:your-secure-mongo-password@mongodb:27017/ai_publishing?authSource=admin

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ai-publishing-assets
S3_ACCESS_KEY_ID=your-minio-access-key
S3_SECRET_ACCESS_KEY=your-minio-secret-key
S3_FORCE_PATH_STYLE=true

VITE_API_BASE_URL=https://api.yourcompany.com
